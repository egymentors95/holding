<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="purchase_order_form_inherit_landed_cost" model="ir.ui.view">
    <field name="name">purchase.order.form.landed.cost</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">

            <button
                name="action_view_landed_costs"
                type="object"
                class="oe_stat_button"
                icon="fa-ship">

                <field name="landed_cost_count" widget="statinfo"
                       string="Landed Costs"/>

            </button>

        </xpath>
    </field>
</record>


</odoo>