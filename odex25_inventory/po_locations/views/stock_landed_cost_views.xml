<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <!-- Inherit Form View to Modify it -->
    <record id="purchase_view_stock_landed_cost_form" model="ir.ui.view">
        <field name="name">purchase.view.stock.landed.cost.form</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[1]/group[2]" position="inside">
                <field name="purchase_order_id"/>
            </xpath>

        </field>
    </record>

    <record id="purchase_view_stock_landed_cost_tree" model="ir.ui.view">
        <field name="name">purchase.view.stock.landed.cost.tree</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="purchase_order_id"/>
            </xpath>

        </field>
    </record>

</odoo>