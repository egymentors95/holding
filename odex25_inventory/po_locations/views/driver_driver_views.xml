<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="driver_driver_view_form" model="ir.ui.view">
        <field name="name">driver_driver_view_form</field>
        <field name="model">driver.driver</field>
        <field name="arch" type="xml">
            <form string="driver_driver_form">
                <sheet>
                    <header>
                        <button name="button_refuse"
                                type="object"
                                string="Refuse"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="button_accept"
                                type="object"
                                string="Accept"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="button_confirm"
                                type="object"
                                string="Accept"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'waiting')]}"/>


                        <field name="state" widget="statusbar"/>
                    </header>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="driver_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="stock_id" invisible="1"/>
                            <field name="sale_id" invisible="1"/>
                            <field name="total_price" invisible="1"/>
                            <field name="total_quantity" invisible="1"/>
                            <field name="source" readonly="1"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detailed Operation">
                            <field name="driver_line_ids" readonly="1">
                                <tree>
                                    <field name="driver_driver_id" attrs="{'column_invisible': 1}"/>
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price" attrs="{'column_invisible': 1}"/>
                                    <field name="total" attrs="{'column_invisible': 1}"/>
                                </tree>
                            </field>

                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="driver_driver_view_tree" model="ir.ui.view">
        <field name="name">driver.driver.view.tree</field>
        <field name="model">driver.driver</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="driver_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="driver_driver_action" model="ir.actions.act_window">
        <field name="name">Driver</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">driver.driver</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- This Menu Item will appear in the Upper bar, That's why It needs NO parent or action -->
    <menuitem id="driver_driver_root" name="Driver" sequence="10"/>
    <!-- This Menu Item Must have a parent -->
    <menuitem id="driver_driver_categ" name="Orders" parent="po_locations.driver_driver_root" sequence="10"/>
    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="driver_action_categ" name="Order" parent="driver_driver_categ" action="driver_driver_action"
              sequence="10"/>

</odoo>