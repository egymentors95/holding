<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="editable_account_view_move_form" model="ir.ui.view">
        <field name="name">editable.account.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">



            <xpath expr="//div[@name='journal_div']/field[@name='currency_id']" position="attributes">
                <attribute name="attrs">{'readonly':1}</attribute>
            </xpath>
            <xpath expr="//div[@class='oe_title']/h1[@class='mt0']" position="inside">
                <field name="name" readonly="1" groups="editable_sale.group_editable_account_move_user"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))], 'required': [('move_type', 'in', ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'])]}</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_account_id']"
                   position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_tag_ids']" position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">-->
<!--                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>-->
<!--            </xpath>-->
              <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="before">
                  <field name="lot_id"/>
            </xpath>


            <xpath expr="//field[@name='line_ids']/tree/field[@name='tax_tag_ids']"
                   position="attributes">
                <attribute name="attrs">{'column_invisible':1}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_account_id']"
                   position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='amount_currency']"
                   position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_tag_ids']"
                   position="attributes">
                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='line_ids']/tree/field[@name='tax_ids']"-->
<!--                   position="attributes">-->
<!--                <attribute name="groups">editable_sale.group_editable_account_move_manager</attribute>-->
<!--            </xpath>-->

            <xpath expr="//field[@name='line_ids']/tree/field[@name='name']"
                   position="attributes">
                <attribute name="string">الشرح</attribute>
            </xpath>
             <xpath expr="//field[@name='line_ids']/tree/field[@name='currency_id']"
                   position="attributes">
                <attribute name="attrs">{'readonly':1}</attribute>
            </xpath>


        </field>
    </record>

    <!-- Inherit Form View to Modify it -->
    <record id="journal_type_view_move_form_asset_inherit" model="ir.ui.view">
        <field name="name">journal.type.view.move.form.asset.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="odex25_account_asset.view_move_form_asset_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='journal_type_id']" position="attributes">
                <attribute name="attrs">{'invisible':1}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
