<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="scrap_view_picking_form" model="ir.ui.view">
        <field name="name">scrap.view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_scrap']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '&amp;', ('picking_type_code', '=', 'incoming'), ('state', '!=', 'done'), '&amp;', ('picking_type_code', '=', 'outgoing'), ('state', '!=', 'done')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>