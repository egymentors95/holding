<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="group_sale_margin_sale_order" model="ir.ui.view">
        <field name="name">group.sale.margin.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='margin']" position="attributes">
                <attribute name="groups">editable_sale.group_sale_margin</attribute>
            </xpath>
            <xpath expr="//div[@class='text-nowrap']" position="attributes">
                <attribute name="groups">editable_sale.group_sale_margin</attribute>
            </xpath>


        </field>
    </record>

</odoo>