<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="inherit_stock_view_warehouse_user_form" model="ir.ui.view">
            <field name="name">inherit.stock.view.warehouse.form</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="user_ids" widget="many2many_tags" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="stock.action_warehouse_form" model="ir.actions.act_window">
            <field name="name">Warehouses</field>
            <field name="res_model">stock.warehouse</field>
            <field name="type">ir.actions.act_window</field>
            <field name="domain">[('user_ids', 'in', [uid])]</field>
            <field name="view_id" ref="stock.view_warehouse_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new warehouse
                </p>
            </field>
        </record>

