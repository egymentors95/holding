<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="inherit_base_view_users_warehouse_form" model="ir.ui.view">
            <field name="name">inherit.base.view.users.warehouse.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='preferences']" position="inside">
                    <field name="warehouse_ids" widget="many2many_tags"/>
                    <field name="location_ids" widget="many2many_tags"/>
<!--                    <field name="operation_ids" widget="many2many_tags"/>-->
                </xpath>
            </field>
        </record>


    </data>
</odoo>