<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <b>Report:</b>
                                Expenses Report
                            </div>
                            <div>
                                <b>Date from:</b>
                                <span t-esc="date_from"/>
                            </div>
                            <div>
                                <b>Date to:</b>
                                <span t-esc="date_to"/>
                            </div>
                            <div>
                                <b>Currency:</b>
                                SR
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/sales_partner_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="expense_report_html">
        <t t-call="web.html_container">
            <t t-call="expense_product_report.custom_header"/>

            <div class="page">
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    <thead>
                        <tr style="background-color: #D9E1F2;">
                            <th style="border: 1px solid #ddd; padding: 8px; text-align: center;">Team</th>
                            <th style="border: 1px solid #ddd; padding: 8px; text-align: center;">Account</th>
                            <t t-foreach="employees" t-as="emp">
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: center;" t-esc="emp"/>
                            </t>
                            <th style="border: 1px solid #ddd; padding: 8px; text-align: center;">Total</th>
                            <th style="border: 1px solid #ddd; padding: 8px; text-align: center;">Achieve %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="grand_total_val" t-value="grand_totals.get('total', 0)"/>
                        <!-- حساب عدد الأعمدة الإجمالي -->
                        <t t-set="total_columns" t-value="len(employees) + 4"/>

                        <t t-foreach="grouped" t-as="team">
                            <!-- Team Header -->
                            <tr style="background-color: #e9ecef;">
                                <td t-att-colspan="total_columns"
                                    style="border: 1px solid #ddd; padding: 8px; text-align: center; font-weight: bold;"
                                    t-esc="team"/>
                            </tr>

                            <!-- Accounts under Team -->
                            <t t-foreach="grouped[team]" t-as="account">
                                <tr>
                                    <td style="border: 1px solid #ddd; padding: 8px;"></td>
                                    <td style="border: 1px solid #ddd; padding: 8px;" t-esc="account"/>

                                    <t t-foreach="employees" t-as="emp">
                                        <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">
                                            <t t-esc="'{:,.2f}'.format(grouped[team][account]['employees'].get(emp, 0.0))"/>

                                        </td>
                                    </t>

                                    <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                        <t t-esc="'{:,.2f}'.format(grouped[team][account]['total'])"/>
                                    </td>
                                    <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">
                                        <t t-if="grand_total_val > 0">
                                            <t t-esc="'{:,.2f}'.format((grouped[team][account]['total'] / grand_total_val * 100))"/>%
                                        </t>
                                        <t t-else="">0.00%</t>
                                    </td>
                                </tr>
                            </t>

                            <!-- Team Subtotal -->
                            <tr style="background-color: #FCE4D6;">
                                <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">Subtotal</td>
                                <td style="border: 1px solid #ddd; padding: 8px;"></td>

                                <t t-foreach="employees" t-as="emp">
                                    <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                        <t t-esc="'{:,.2f}'.format(team_summaries[team].get(emp, 0.0))"/>
                                    </td>
                                </t>

                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                    <t t-esc="'{:,.2f}'.format(team_summaries[team]['total'])"/>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 8px;"></td>
                            </tr>

                            <!-- Team Achieve -->
                            <tr style="background-color: #FCE4D6;">
                                <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">Achieve %</td>
                                <td style="border: 1px solid #ddd; padding: 8px;"></td>

                                <t t-foreach="employees" t-as="emp">
                                    <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">
                                        <t t-if="grand_total_val > 0">
                                            <t t-esc="'{:,.2f}'.format(team_summaries[team]['achieve'].get(emp, 0))"/>%
                                        </t>
                                        <t t-else="">0.00%</t>
                                    </td>
                                </t>

                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">
                                    <t t-if="grand_total_val > 0">
                                        <t t-esc="'{:,.2f}'.format(team_summaries[team]['achieve']['total'])"/>%
                                    </t>
                                    <t t-else="">0.00%</t>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 8px;"></td>
                            </tr>

                            <!-- Empty row for spacing -->
                            <tr>
                                <td t-att-colspan="total_columns" style="height: 10px;"></td>
                            </tr>
                        </t>

                        <!-- Grand Total -->
                        <tr style="background-color: #C6E0B4;">
                            <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">Grand Total</td>
                            <td style="border: 1px solid #ddd; padding: 8px;"></td>

                            <t t-foreach="employees" t-as="emp">
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                    <t t-esc="'{:,.2f}'.format(grand_totals.get(emp, 0.0))"/>
                                </td>
                            </t>

                            <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                <t t-esc="'{:,.2f}'.format(grand_totals['total'])"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                100.00%
                            </td>
                        </tr>

                        <!-- Total Sales -->
                        <tr style="background-color: #FFE699;">
                            <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">Total Gross Profit</td>
                            <td style="border: 1px solid #ddd; padding: 8px;"></td>

                            <t t-foreach="employees" t-as="emp">
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                    <t t-esc="'{:,.2f}'.format(sales_data.get('by_employee', {}).get(emp, {}).get('net_profit', 0.0))"/>

                                </td>
                            </t>

                            <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">
                                <t t-esc="'{:,.2f}'.format(sales_data.get('total_net_profit', 0.0))"/>
                            </td>
                            <td style="border: 1px solid #ddd; padding: 8px;"></td>
                        </tr>
                    </tbody>
                </table>
                 <style>
                    .table {
                        width: 100%;
                        margin-bottom: 1rem;
                        color: #212529;
                    }
                    .table-bordered {
                        border: 1px solid #dee2e6;
                    }
                    .table-bordered th,
                    .table-bordered td {
                        border: 1px solid #dee2e6;
                    }
                    .table-bordered thead th,
                    .table-bordered thead td {
                        border-bottom-width: 2px;
                    }
                </style>

            </div>
        </t>
    </template>

</odoo>