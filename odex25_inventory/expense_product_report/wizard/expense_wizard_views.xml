<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="expense_wizard_view_form" model="ir.ui.view">
            <field name="name">expense.wizard.view</field>
            <field name="model">expense.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="team_ids" widget="many2many_tags"/>
                                <field name="account_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="View(Report)" name="action_print_report_html" type="object" class="btn-primary"/>
                        <button string="Export Xlsx" name="action_print_report_xlsx" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="expense_wizard_view_action" model="ir.actions.act_window">
            <field name="name">Expenses Report</field>
            <field name="res_model">expense.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
            </field>
        </record>

        <menuitem id="expense_wizard_view_menu" name="Expenses Report"
                  parent="account.menu_finance_reports"
                  sequence="300"/>
         <menuitem id="expense_wizard_view_menu_one" name="Expense Report"
                  parent="expense_wizard_view_menu"
                   action="expense_wizard_view_action"
                  sequence="100"/>


    </data>
</odoo>