<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="partner_category_view_move_form" model="ir.ui.view">
        <field name="name">partner.category.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[1]/group[2]" position="inside">
                <field name="partner_category_id"/>
            </xpath>


            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="is_partner" attrs="{'column_invisible': 1}"/>
                <field name="is_analytic" attrs="{'column_invisible': 1}"/>
            </xpath>


            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='partner_id']" position="attributes">
                <attribute name="attrs">{
                    'readonly': [
                    ('is_partner','=',False),
                    ]
                    }
                </attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_account_id']" position="attributes">
                <attribute name="attrs">{
                    'readonly': [
                    ('is_analytic','=',False),
                    ]
                    }
                </attribute>
            </xpath>

            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="domain">[('allowed_user_ids', 'in', uid)]</attribute>
            </xpath>


        </field>
    </record>

    <!-- Inherit Form View to Modify it -->
    <record id="product_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">product.view.account.invoice.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <field name="name" string="product" filter_domain="[('invoice_line_ids.product_id','=',self)]"/>
            </xpath>

        </field>
    </record>


    <record id="server_action_server_action_partner_category" model="ir.actions.server">
        <field name="name">Set Partner Category on Invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = records.server_action_partner_category()</field>
    </record>

</odoo>