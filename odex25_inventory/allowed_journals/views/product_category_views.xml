<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product.product_category_action_form" model="ir.actions.act_window">
        <field name="domain">[('allowed_user_ids', 'in', uid)]</field>
    </record>


    <record id="rule_product_by_category_allowed_users" model="ir.rule">
        <field name="name">Products by Allowed Categories</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">
            ['|',
            ('categ_id.allowed_user_ids', '=', False),
            ('categ_id.allowed_user_ids', 'in', user.id)
            ]
        </field>
    </record>

    <record id="rule_product_template_by_category_allowed_users" model="ir.rule">
        <field name="name">Product Templates by Allowed Categories</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">
            ['|',
            ('categ_id.allowed_user_ids', '=', False),
            ('categ_id.allowed_user_ids', 'in', user.id)
            ]
        </field>
    </record>


</odoo>
