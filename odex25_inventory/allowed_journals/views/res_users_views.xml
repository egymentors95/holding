<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    
    <!-- Inherit Form View to Modify it -->
    <record id="journal_allowed_view_users_form" model="ir.ui.view">
        <field name="name">journal.allowed.view.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="allowed_journal_ids" widget="many2many_tags"/>
                <field name="allowed_category_ids" widget="many2many_tags"/>
            </xpath>

        </field>
    </record>
    
</odoo>