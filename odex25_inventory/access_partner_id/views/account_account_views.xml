<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="type_view_account_list" model="ir.ui.view">
        <field name="name">type_view_account_list</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="inside">
                <field name="selection_type" attrs="{'column_invisible': 1}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Form View to Modify it -->
    <record id="bt_cash_view_account_form" model="ir.ui.view">
        <field name="name">bt.cash.view.account.form</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">

                  <xpath expr="//group[1]/group[2]" position="inside">
                <field name="is_bt_cash"/>
            </xpath>


        </field>
    </record>

</odoo>