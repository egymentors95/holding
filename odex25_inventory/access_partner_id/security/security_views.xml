<?xml version="1.0" encoding="UTF-8" ?>
<odoo>



    <record id="module_category_contacts_global" model="ir.module.category">
        <field name="name">Contacts</field>
        <field name="description">Contacts</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_contacts_user_global" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_contacts_global"/>
    </record>



    <record id="group_contacts_admin_global" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_contacts_global"/>
        <field name="implied_ids" eval="[(4, ref('group_contacts_user_global'))]"/>
    </record>


    <record id="contact_user_global_rule" model="ir.rule">
        <field name="name">Contacts User</field>
        <field name="model_id" ref="stock.model_res_partner"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_ids', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_user_global'))]"/>
    </record>



    <record id="contact_admin_global_rule" model="ir.rule">
        <field name="name">Contacts Admin</field>
        <field name="model_id" ref="stock.model_res_partner"/>
        <field name="domain_force">['|',('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_admin_global'))]"/>
    </record>


</odoo>