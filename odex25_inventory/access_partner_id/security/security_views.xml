<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

  <record id="menu_item_price_lists" model="res.groups">
        <field name="name">Menuitem Pricelists</field>
    </record>

    <record id="module_category_contacts_global" model="ir.module.category">
        <field name="name">Contacts</field>
        <field name="description">Contacts</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_contacts_user_global" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_contacts_global"/>
    </record>

    <record id="group_sales_team" model="res.groups">
        <field name="name">Sales Team</field>
        <field name="category_id" ref="module_category_contacts_global"/>
        <field name="implied_ids" eval="[(4, ref('group_contacts_user_global'))]"/>

    </record>

    <record id="group_contacts_admin_global" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_contacts_global"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_team'))]"/>
    </record>


    <!--    _____________________________Contact Rules_______________________________-->

    <record id="contact_user_global_rule" model="ir.rule">
        <field name="name">Contacts User</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('sales_person_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_user_global'))]"/>
    </record>

    <record id="contact_team_global_rule" model="ir.rule">
        <field name="name">Contacts Team</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|',('team_id.user_id', '=', user.id),('team_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_sales_team'))]"/>
    </record>

    <record id="contact_admin_global_rule" model="ir.rule">
        <field name="name">Contacts Admin</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_admin_global'))]"/>
    </record>



    <!--    _____________________________Sales Rules_______________________________-->

    <record id="sale_order_rule_user" model="ir.rule">
        <field name="name">Sales Order: User</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_user_global'))]"/>
    </record>
    <record id="sale_order_rule_sales_team" model="ir.rule">
        <field name="name">Sales Order: Sales Team</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_sales_team'))]"/>
    </record>
    <record id="sale_order_rule_admin" model="ir.rule">
        <field name="name">Sales Order: Admin</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_admin_global'))]"/>
    </record>

    <!--    _____________________________Purchase Rules_______________________________-->

    <record id="purchase_order_rule_user" model="ir.rule">
        <field name="name">Purchase Order: user</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_user_global'))]"/>
    </record>
    <record id="purchase_order_rule_sales_team" model="ir.rule">
        <field name="name">Purchase Order: Sales Team</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_sales_team'))]"/>
    </record>
    <record id="purchase_order_rule_admin" model="ir.rule">
        <field name="name">Purchase Order: Sales Team</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_admin_global'))]"/>
    </record>

    <!--    ____________________________Invoices Rules_______________________________-->

    <record id="account_invoice_rule_user" model="ir.rule">
        <field name="name">Invoice: User</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_user_global'))]"/>
    </record>
    <record id="account_invoice_rule_sales_team" model="ir.rule">
        <field name="name">Invoice: Sales Team</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_sales_team'))]"/>
    </record>
    <record id="account_invoice_rule_admin" model="ir.rule">
        <field name="name">Invoice: Admin</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('access_partner_id.group_contacts_admin_global'))]"/>
    </record>


</odoo>