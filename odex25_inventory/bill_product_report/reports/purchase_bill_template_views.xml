<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <span style="font-weight: bold;">Report:</span>
                                <span>Purchase Report</span>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date from:</span>
                                <span t-esc="report_data and report_data.get('date_from')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date to:</span>
                                <span t-esc="report_data and report_data.get('date_to')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Currency:</span>
                                <span t-esc="report_data and report_data.get('currency_name')"/>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/bill_product_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="purchase_bill_html_report">
        <t t-call="web.html_container">
            <t t-call="bill_product_report.custom_header"/>

            <div class="page">
                <!--                        &lt;!&ndash; 🔹 زر طباعة PDF &ndash;&gt;-->
                <!--        <div style="text-align: right; margin-bottom: 20px;">-->
                <!--          <a t-att-href="'/report/pdf/bill_product_report.purchase_bill_html_report/%s' % (docs and docs[0].id or 0)"-->
                <!--             target="_blank"-->
                <!--             class="btn btn-primary">-->
                <!--            🖨️ طباعة PDF-->
                <!--          </a>-->
                <!--        </div>-->

                <table class="table table-sm table-bordered"
                       style="width:100%; border: 1px solid black; text-align: center;">
                    <thead style="background-color: #f0f0f0; font-weight: bold;">
                        <tr style="border: 1px solid black;">
                            <th style="border: 1px solid black;" rowspan="2">Product Category</th>
                            <th style="border: 1px solid black;" rowspan="2">Code</th>
                            <th style="border: 1px solid black;" rowspan="2">Product</th>

                            <!-- QTY -->
                            <th style="border: 1px solid black;  background-color:#27C2F5;" colspan="6">Received QTY
                            </th>

                            <!-- Full Year Plan -->
                            <th style="border: 1px solid black; background-color:#27F5C1;" colspan="3">Full Year Plan
                            </th>
                        </tr>
                        <tr style="border: 1px solid black;">
                            <!-- Sub headers -->
                            <th style="border: 1px solid black; background-color:#27C2F5;">Main Qty</th>
                            <th style="border: 1px solid black; background-color:#27C2F5;">Foc</th>
                            <th style="border: 1px solid black; background-color:#27C2F5;">Total Qty</th>
                            <th style="border: 1px solid black; background-color:#27C2F5;">Percentage</th>
                            <th style="border: 1px solid black; background-color:#27C2F5;">Value</th>
                            <th style="border: 1px solid black; background-color:#27C2F5;">NAAP</th>

                            <!--                            <th style="border: 1px solid black; background-color:#27F5C1;">Vendor</th>-->
                            <th style="border: 1px solid black; background-color:#27F5C1;">QTY</th>
                            <th style="border: 1px solid black;  background-color:#27F5C1;">Value</th>
                            <th style="border: 1px solid black;  background-color:#27F5C1;">Ach.%</th>

                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="last_category" t-value="None"/>
                        <t t-set="totals" t-value="{'Total Quantity': 0, 'Foc': 0, 'Total Price': 0, 'Nsap': 0, 'Grand Total Qty': 0, 'Percentage': 0,
                                'Plan Quantity': 0, 'Plan Value': 0, 'Achive': 0}"/>

                        <t t-foreach="(report_data or {}).get('product_ids', [])" t-as="line">

                            <!-- لو الكاتيجوري اتغيرت -->
                            <t t-if="last_category and line['Product Category'] != last_category">
                                <!-- اطبع subtotal -->
                                <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                    <td colspan="3" style="text-align:center; border: 1px solid black;">Subtotal</td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Total Quantity'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Foc'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Grand Total Qty'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Percentage'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Total Price'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Nsap'] or 0)"/>
                                    </td>
                                    <!--                <td></td>-->
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Plan Quantity'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Plan Value'] or 0)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="'{:,.2f}'.format(totals['Achive'] or 0)"/>
                                    </td>
                                </tr>

                                <!-- reset totals -->
                                <t t-set="totals" t-value="{'Total Quantity': 0, 'Foc': 0, 'Total Price': 0, 'Nsap': 0, 'Grand Total Qty': 0, 'Percentage': 0,
                                        'Plan Quantity': 0, 'Plan Value': 0, 'Achive': 0}"/>
                            </t>

                            <!-- لو كاتيجوري جديدة اطبع اسمها -->
                            <t t-if="line['Product Category'] != last_category">
                                <tr style="background-color:#F0EBEB; font-weight:bold; border: 1px solid black;">
                                    <td colspan="10" style="text-align: left; border: 1px solid black;">
                                        <t t-esc="line['Product Category']"/>
                                    </td>
                                </tr>
                                <t t-set="last_category" t-value="line['Product Category']"/>
                            </t>

                            <!-- بيانات المنتج -->
                            <tr style="border: 1px solid black;">
                                <td></td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Default Code']"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Product']"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Total Quantity'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Foc'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Grand Total Qty'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Percentage'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Total Price'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Nsap'] or 0)"/>
                                </td>
                                <!--            <td style="border: 1px solid black; text-align: center;"><t t-esc="line['Vendor']"/></td>-->
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Plan Quantity'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Plan Value'] or 0)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="'{:,.2f}'.format(line['Achive'] or 0)"/>
                                </td>
                            </tr>

                            <!-- تحديث totals -->
                            <t t-set="totals" t-value="{
            'Total Quantity': totals['Total Quantity'] + (line['Total Quantity'] or 0),
            'Foc': totals['Foc'] + (line['Foc'] or 0),
            'Total Price': totals['Total Price'] + (line['Total Price'] or 0),
            'Nsap': totals['Nsap'] + (line['Nsap'] or 0),
            'Plan Quantity': totals['Plan Quantity'] + (line['Plan Quantity'] or 0),
            'Plan Value': totals['Plan Value'] + (line['Plan Value'] or 0),
            'Achive': totals['Achive'] + (line['Achive'] or 0),
            'Grand Total Qty': totals['Grand Total Qty'] + (line['Grand Total Qty'] or 0),
            'Percentage': totals['Percentage'] + (line['Percentage'] or 0),
        }"/>
                        </t>

                        <!-- Subtotal بعد آخر كاتيجوري -->
                        <t t-if="last_category">
                            <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                <td colspan="3" style="text-align:center; border: 1px solid black;">Subtotal</td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Total Quantity']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Foc']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Grand Total Qty']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Percentage']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Total Price']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Nsap']"/>
                                </td>
                                <!--            <td></td>-->
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Plan Quantity']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Plan Value']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Achive'],2)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>

                </table>
            </div>
        </t>
    </template>

</odoo>
