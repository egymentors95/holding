<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="sales_plan_user" model="res.groups">
        <field name="name">Sales Plan User</field>
    </record>
    <record id="sales_plan_admin" model="res.groups">
        <field name="name">Sales Plan Admin</field>
    </record>

    <record id="sales_plan_user_rule" model="ir.rule">
        <field name="name">Sales Plan: User</field>
        <field name="model_id" ref="product_report.model_sales_plan"/>
        <field name="domain_force">[('sales_person_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('product_report.sales_plan_user'))]"/>
    </record>
    <record id="sales_plan_admin_rule" model="ir.rule">
        <field name="name">Sales Plan: Admin</field>
        <field name="model_id" ref="product_report.model_sales_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('product_report.sales_plan_admin'))]"/>
    </record>

</odoo>