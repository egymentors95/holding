<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <span style="font-weight: bold;">Report:</span>
                                <span>Sales Report</span>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date from:</span>
                                <span t-esc="report_data and report_data.get('date_from')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date to:</span>
                                <span t-esc="report_data and report_data.get('date_to')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Currency:</span>
                                <span>SR</span>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/bill_product_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="profitability_report_html">
        <t t-call="web.html_container">
            <t t-call="product_report.custom_header"/>

            <div class="page">
                <table class="table table-sm table-bordered"
                       style="width:100%; border: 1px solid black; text-align: center;">
                    <thead style="background-color: #f0f0f0; font-weight: bold; text-align: center;">
                        <tr style="border: 1px solid black;">
                            <th style="border: 1px solid black;" rowspan="2">Product Category</th>
                            <th style="border: 1px solid black;" rowspan="2">Code</th>
                            <th style="border: 1px solid black;" rowspan="2">Product</th>

                            <!-- Last Year -->
                            <th style="border: 1px solid black; background-color: #27C2F5;" colspan="3">
                                Last (
                                <t t-esc="date_from_last_year"/>
                                →<t t-esc="date_to_last_year"/>)
                            </th>

                            <!-- Current -->
                            <th style="border: 1px solid black; background-color: #27F5C1;" colspan="4">
                                Current (
                                <t t-esc="report_data and report_data.get('date_from')"/>
                                →<t t-esc="report_data and report_data.get('date_to')"/>)
                            </th>

                            <!-- YTD Plan -->
                            <th style="border: 1px solid black; background-color: #C8DA44;" colspan="3">
                                YTD Plan (
                                <t t-esc="report_data and report_data.get('date_from')"/>
                                →<t t-esc="report_data and report_data.get('date_to')"/>)
                            </th>

                            <th style="border: 1px solid black; background-color: #E6376F;" colspan="2">Achived %</th>
                        </tr>
                        <tr style="border: 1px solid black;">
                            <!-- Sub headers Last -->
                            <th style="border: 1px solid black; background-color: #27C2F5;">QTY</th>
                            <th style="border: 1px solid black; background-color: #27C2F5;">Value</th>
                            <th style="border: 1px solid black; background-color: #27C2F5;">NASP</th>

                            <!-- Sub headers Current -->
                            <th style="border: 1px solid black; background-color: #27F5C1;">Total QTY</th>
                            <th style="border: 1px solid black; background-color: #27F5C1;">Total Value</th>
                            <th style="border: 1px solid black; background-color: #27F5C1;">NASP</th>
                            <th style="border: 1px solid black; background-color: #27F5C1;">Sales Person</th>

                            <!-- Sub headers YTD Plan -->
                            <th style="border: 1px solid black; background-color: #C8DA44;">Plan QTY</th>
                            <th style="border: 1px solid black; background-color: #C8DA44;">Value</th>
                            <th style="border: 1px solid black; background-color: #C8DA44;">NASP</th>

                            <th style="border: 1px solid black; background-color: #E6376F;">Qty %</th>
                            <th style="border: 1px solid black; background-color: #E6376F;">Value %</th>

                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="last_category" t-value="None"/>
                        <t t-set="totals" t-value="{
        'Last Year Total Quantity': 0,
        'Last Year Total Price': 0,
        'Last Year Nsap': 0,
        'Total Quantity': 0,
        'Total Price': 0,
        'Nsap': 0,
        'Total Plan Quantity': 0,
        'Total Plan Price': 0,
        'Plan Nsap': 0,
        'QTY': 0,
        'Value': 0
    }"/>

                        <t t-foreach="(report_data or {}).get('product_ids', [])" t-as="line">

                            <!-- لو الكاتيجوري اتغيرت -->
                            <t t-if="last_category and line['Product Category'] != last_category">
                                <!-- Subtotal -->
                                <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                    <td colspan="3" style="text-align:center; border: 1px solid black;">Total</td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Last Year Total Quantity']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Last Year Total Price']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Last Year Nsap'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Total Quantity']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Total Price']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Nsap'],2)"/>
                                    </td>
                                    <td></td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Total Plan Quantity']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Total Plan Price']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Plan Nsap'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['QTY']"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="totals['Value']"/>
                                    </td>
                                </tr>

                                <!-- Reset totals -->
                                <t t-set="totals" t-value="{
                'Last Year Total Quantity': 0,
                'Last Year Total Price': 0,
                'Last Year Nsap': 0,
                'Total Quantity': 0,
                'Total Price': 0,
                'Nsap': 0,
                'Total Plan Quantity': 0,
                'Total Plan Price': 0,
                'Plan Nsap': 0,
                'QTY': 0,
                'Value': 0
            }"/>
                            </t>

                            <!-- كاتيجوري جديدة -->
                            <t t-if="line['Product Category'] != last_category">
                                <tr style="background-color:#F0EBEB; font-weight:bold; border: 1px solid black;">
                                    <td colspan="15" style="text-align:left; border: 1px solid black;">
                                        <t t-esc="line['Product Category']"/>
                                    </td>
                                </tr>
                                <t t-set="last_category" t-value="line['Product Category']"/>
                            </t>

                            <!-- بيانات المنتج -->
                            <tr style="border: 1px solid black;">
                                <td></td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="line['Default Code']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="line['Product']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Last Year Total Quantity']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Last Year Total Price']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Last Year Nsap']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Total Quantity']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Total Price']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="round(line['Nsap'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Sales Person']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Total Plan Quantity']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Total Plan Price']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="round(line['Plan Nsap'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['QTY']"/>
                                </td>
                                <td style="border: 1px solid black; text-align:center;">
                                    <t t-esc="line['Value']"/>
                                </td>
                            </tr>

                            <!-- تحديث totals -->
                            <t t-set="totals" t-value="{
            'Last Year Total Quantity': totals['Last Year Total Quantity'] + (line['Last Year Total Quantity'] or 0),
            'Last Year Total Price': totals['Last Year Total Price'] + (line['Last Year Total Price'] or 0),
            'Last Year Nsap': totals['Last Year Nsap'] + (line['Last Year Nsap'] or 0),
            'Total Quantity': totals['Total Quantity'] + (line['Total Quantity'] or 0),
            'Total Price': totals['Total Price'] + (line['Total Price'] or 0),
            'Nsap': totals['Nsap'] + (line['Nsap'] or 0),
            'Total Plan Quantity': totals['Total Plan Quantity'] + (line['Total Plan Quantity'] or 0),
            'Total Plan Price': totals['Total Plan Price'] + (line['Total Plan Price'] or 0),
            'Plan Nsap': totals['Plan Nsap'] + (line['Plan Nsap'] or 0),
            'QTY': totals['QTY'] + (line['QTY'] or 0),
            'Value': totals['Value'] + (line['Value'] or 0)
        }"/>
                        </t>

                        <!-- Subtotal آخر كاتيجوري -->
                        <t t-if="last_category">
                            <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                <td colspan="3" style="text-align:center; border: 1px solid black;">Total</td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Last Year Total Quantity']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Last Year Total Price']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="totals['Last Year Nsap']"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total Quantity'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total Price'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Nsap'],2)"/>
                                </td>
                                <td></td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total Plan Quantity'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total Plan Price'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Plan Nsap'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['QTY'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Value'],2)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>

                </table>
            </div>
        </t>
    </template>

</odoo>
