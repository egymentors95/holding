<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="paperformat_sales_html" model="report.paperformat">
        <field name="name">Sales Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">34</field>
        <field name="dpi">90</field>
    </record>


    <record id="report_action_profitability" model="ir.actions.report">
        <field name="name">Profitability XLS Report</field>
        <field name="model">profitability.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">product_report.profitability_report</field>
        <field name="report_file">product_report.profitability_report</field>
        <field name="binding_type">report</field>
    </record>

    <record id="report_action_sales_html" model="ir.actions.report">
        <field name="name">Sales Report</field>
        <field name="model">profitability.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">product_report.profitability_report_html</field>
        <field name="report_file">product_report.profitability_report_html</field>
        <field name="paperformat_id" ref="paperformat_sales_html"/>

        <field name="binding_type">report</field>
    </record>


</odoo>