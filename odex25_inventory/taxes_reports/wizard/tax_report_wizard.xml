<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tax_report_wizard_view_form" model="ir.ui.view">
            <field name="name">tax.report.wizard.view.form</field>
            <field name="model">tax.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Export Xlsx" name="action_print_report_xlsx" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="tax_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Tax Report</field>
            <field name="res_model">tax.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
            </field>
        </record>

        <menuitem id="tax_report_menu_root" name="Taxes Report"
                  parent="account.menu_finance_reports"
                  sequence="400"/>
         <menuitem id="tax_report_wizard_menuitem" name="Taxes Report"
                  parent="taxes_reports.tax_report_menu_root"
                   action="taxes_reports.tax_report_wizard_action"
                  sequence="100"/>


    </data>
</odoo>