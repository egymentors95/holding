<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <span style="font-weight: bold;">Report:</span>
                                <span>Inventory Report</span>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date from:</span>
                                <span t-esc="report_data and report_data.get('date_from')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date to:</span>
                                <span t-esc="report_data and report_data.get('date_to')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Currency:</span>
                                <span>SR or USD</span>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/inventory_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="inventory_report_html">
        <t t-call="web.html_container">
            <t t-call="inventory_report.custom_header"/>

            <div class="page">
                <table class="table table-sm table-bordered"
                       style="width:100%; border: 1px solid black; text-align: center;">
                    <thead style="background-color: #f0f0f0; font-weight: bold;">
                        <tr>
                            <th>Product Category</th>
                            <th>Code</th>
                            <th>Product</th>
                            <th>Lot</th>
                            <th>Expiry Date</th>
                            <th>QTY</th>
                            <th>Total Dos</th>
                            <th>QTY Last 6M</th>
                            <th>QTY Avg</th>
                            <th>Equ/Month</th>
                            <th>NAAP</th>
                            <th>Value</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="last_category" t-value="None"/>
                        <t t-set="last_private" t-value="None"/>
                        <t t-set="cat_totals" t-value="{'qty':0,'dos':0,'qty6m':0,'avg':0,'equ':0,'naap':0,'val':0}"/>
                        <t t-set="priv_totals" t-value="{'qty':0,'dos':0,'qty6m':0,'avg':0,'equ':0,'naap':0,'val':0}"/>

                        <t t-foreach="(report_data or {}).get('product_ids', [])" t-as="line">

                            <!-- Product Category change -->
                            <t t-if="last_category and line['Product Category'] != last_category">
                                <!-- Subtotal for last Private Category -->
                                <tr style="background-color:#EEE;font-weight:bold;">
                                    <td colspan="5" style="text-align:left;">Subtotal</td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['qty'])"/>
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['dos']/1000000)"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['qty6m'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['avg'])"/>


                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['equ'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['naap'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['val'])"/>

                                    </td>
                                </tr>
                                <t t-set="priv_totals"
                                   t-value="{'qty':0,'dos':0,'qty6m':0,'avg':0,'equ':0,'naap':0,'val':0}"/>

                                <!-- Total for last Product Category -->
                                <tr style="background-color:#DCDCDC;font-weight:bold;">
                                    <td colspan="5" style="text-align:left;">Total (<t t-esc="last_category"/>)
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['qty'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['dos']/1000000)"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['qty6m'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['avg'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['equ'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['naap'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(cat_totals['val'])"/>

                                    </td>
                                </tr>

                                <t t-set="cat_totals"
                                   t-value="{'qty':0,'dos':0,'qty6m':0,'avg':0,'equ':0,'naap':0,'val':0}"/>
                                <t t-set="last_private" t-value="None"/>
                            </t>

                            <!-- Private Category change -->
                            <t t-if="last_private and line.get('private_category') != last_private">
                                <tr style="background-color:#EEE;font-weight:bold;">
                                    <td colspan="5" style="text-align:left;">Subtotal</td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['qty'])"/>

                                    </td>

                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['dos']/1000000)"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['qty6m'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['avg'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['equ'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['naap'])"/>

                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(priv_totals['val'])"/>

                                    </td>
                                </tr>
                                <t t-set="priv_totals"
                                   t-value="{'qty':0,'dos':0,'qty6m':0,'avg':0,'equ':0,'naap':0,'val':0}"/>
                            </t>

                            <!-- New Product Category -->
                            <t t-if="line['Product Category'] != last_category">
                                <tr style="background-color:#F0EBEB;font-weight:bold;">
                                    <td colspan="12" style="text-align:left;">
                                        <t t-esc="line['Product Category']"/>
                                    </td>
                                </tr>
                                <t t-set="last_category" t-value="line['Product Category']"/>
                                <t t-set="last_private" t-value="None"/>
                            </t>

                            <!-- Product row -->
                            <tr>
                                <td></td>
                                <td>
                                    <t t-esc="line['Default Code']"/>
                                </td>
                                <td>
                                    <t t-esc="line['Product']"/>
                                </td>
                                <td>
                                    <t t-esc="line['Lots']"/>
                                </td>
                                <td>
                                    <t t-esc="line['expiry_date']"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['on_hand_qty'])"/>

                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['Total Dos'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['sold_last_6_months'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['avg_sold_last_6_months'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['equ_month'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['naap'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['value'])"/>
                                </td>
                            </tr>

                            <!-- update totals -->
                            <t t-set="priv_totals" t-value="{
                                'qty': priv_totals['qty'] + (line['on_hand_qty'] or 0),
                                'dos': priv_totals['dos'] + (line['Total Dos'] or 0),
                                'qty6m': priv_totals['qty6m'] + (line['sold_last_6_months'] or 0),
                                'avg': priv_totals['avg'] + (line['avg_sold_last_6_months'] or 0),
                                'equ': priv_totals['equ'] + (line['equ_month'] or 0),
                                'naap': priv_totals['naap'] + (line['naap'] or 0),
                                'val': priv_totals['val'] + (line['value'] or 0)
                            }"/>
                            <t t-set="cat_totals" t-value="{
                                'qty': cat_totals['qty'] + (line['on_hand_qty'] or 0),
                                'dos': cat_totals['dos'] + (line['Total Dos'] or 0),
                                'qty6m': cat_totals['qty6m'] + (line['sold_last_6_months'] or 0),
                                'avg': cat_totals['avg'] + (line['avg_sold_last_6_months'] or 0),
                                'equ': cat_totals['equ'] + (line['equ_month'] or 0),
                                'naap': cat_totals['naap'] + (line['naap'] or 0),
                                'val': cat_totals['val'] + (line['value'] or 0)
                            }"/>

                            <t t-set="last_private" t-value="line.get('private_category')"/>
                        </t>

                        <!-- Final subtotals after loop -->
                        <t t-if="last_private">
                            <tr style="background-color:#EEE;font-weight:bold;">
                                <td colspan="5" style="text-align:left;">Subtotal</td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['qty'])"/>

                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['dos']/1000000)"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['qty6m'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['avg'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['equ'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['naap'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(priv_totals['val'])"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="last_category">
                            <tr style="background-color:#DCDCDC;font-weight:bold;">
                                <td colspan="5" style="text-align:left;">Total (<t t-esc="last_category"/>)
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['qty'])"/>

                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['dos']/1000000)"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['qty6m'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['avg'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['equ'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['naap'])"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(cat_totals['val'])"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
