<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <span style="font-weight: bold;">Report:</span>
                                <span>Inventory Report</span>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date from:</span>
                                <span t-esc="report_data and report_data.get('date_from')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date to:</span>
                                <span t-esc="report_data and report_data.get('date_to')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Currency:</span>
                                <span>SR or USD</span>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/inventory_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="inventory_report_html">
        <t t-call="web.html_container">
            <t t-call="inventory_report.custom_header"/>

            <div class="page">
                <table class="table table-sm table-bordered"
                       style="width:100%; border: 1px solid black; text-align: center;">
                    <thead style="background-color: #f0f0f0; font-weight: bold;">
                        <tr style="border: 1px solid black;">
                            <th style="border: 1px solid black;">Product Category</th>
                            <th style="border: 1px solid black;">Code</th>
                            <th style="border: 1px solid black;">Product</th>
                            <th style="border: 1px solid black;">Lot</th>
                            <th style="border: 1px solid black;">Expiry Date</th>
                            <th style="border: 1px solid black;">Total Dos</th>
                            <th style="border: 1px solid black;">QTY</th>
                            <th style="border: 1px solid black;">QTY Last 6M</th>
                            <th style="border: 1px solid black;">QTY Avg</th>
                            <th style="border: 1px solid black;">Equ/Month</th>
                            <th style="border: 1px solid black;">NAAP</th>
                            <th style="border: 1px solid black;">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="last_category" t-value="None"/>
                        <t t-set="totals" t-value="{'Total QTY': 0, 'QTY Last 6M': 0, 'QTY Avg': 0, 'Equ Month':0,
                                'NAAP': 0, 'Value': 0,'Total_dos':0}"/>

                        <t t-foreach="(report_data or {}).get('product_ids', [])" t-as="line">

                            <!-- لو الكاتيجوري اتغيرت -->
                            <t t-if="last_category and line['Product Category'] != last_category">
                                <!-- اطبع subtotal -->
                                <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                    <td colspan="5" style="text-align:left; border: 1px solid black;">Total</td>

                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Total QTY'],2)"/>
                                    </td>
                                                                        <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Total_dos'],2)"/>
                                    </td>

                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['QTY Last 6M'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['QTY Avg'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Equ Month'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['NAAP'],2)"/>
                                    </td>
                                    <td style="border: 1px solid black;">
                                        <t t-esc="round(totals['Value'],2)"/>
                                    </td>
                                </tr>

                                <!-- reset totals -->
                                <t t-set="totals" t-value="{'Total QTY': 0, 'QTY Last 6M': 0, 'QTY Avg': 0,'Equ Month':0,
                                'NAAP': 0, 'Value': 0,'Total_dos':0}"/>
                            </t>

                            <!-- لو كاتيجوري جديدة اطبع اسمها -->
                            <t t-if="line['Product Category'] != last_category">
                                <tr style="background-color:#F0EBEB; font-weight:bold; border: 1px solid black;">
                                    <td colspan="12" style="text-align: left; border: 1px solid black;">
                                        <t t-esc="line['Product Category']"/>
                                    </td>
                                </tr>
                                <t t-set="last_category" t-value="line['Product Category']"/>
                            </t>

                            <!-- بيانات المنتج -->
                            <tr style="border: 1px solid black;">
                                <td></td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Default Code']"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Product']"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Lots']"/>
                                </td>

                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['expiry_date']"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="line['Total Dos']"/>
                                </td>

                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['on_hand_qty'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['sold_last_6_months'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['avg_sold_last_6_months'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['equ_month'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['naap'],2)"/>
                                </td>
                                <td style="border: 1px solid black; text-align: center;">
                                    <t t-esc="round(line['value'],2)"/>
                                </td>
                            </tr>

                            <!-- تحديث totals -->
                            <t t-set="totals" t-value="{
            'Total QTY': totals['Total QTY'] + (line['on_hand_qty'] or 0),
            'QTY Last 6M': totals['QTY Last 6M'] + (line['sold_last_6_months'] or 0),
            'QTY Avg': totals['QTY Avg'] + (line['avg_sold_last_6_months'] or 0),
            'NAAP': totals['NAAP'] + (line['naap'] or 0),
            'Equ Month': totals['Equ Month'] + (line['equ_month'] or 0),
            'Value': totals['Value'] + (line['value'] or 0),
            'Total_dos': totals['Total_dos'] + (line['Total Dos'] or 0),
        }"/>
                        </t>

                        <!-- Subtotal بعد آخر كاتيجوري -->
                        <t t-if="last_category">
                            <tr style="background-color:#EEE; font-weight:bold; border: 1px solid black;">
                                <td colspan="5" style="text-align:left; border: 1px solid black;">Total</td>

                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total QTY'],2)"/>
                                </td>
                                                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Total_dos'],2)"/>
                                </td>

                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['QTY Last 6M'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['QTY Avg'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Equ Month'],2)"/>
                                </td>
                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['NAAP'],2)"/>
                                </td>

                                <td style="border: 1px solid black;">
                                    <t t-esc="round(totals['Value'],2)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>

                </table>
            </div>
        </t>
    </template>

</odoo>
