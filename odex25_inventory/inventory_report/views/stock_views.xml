<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_views_tree" model="ir.ui.view">
        <field name="name">stock.views.tree</field>
        <field name="model">stock.views</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="product_category"/>
                <field name="product_name"/>
                <field name="default_code"/>
                <field name="Lots"/>
                <field name="on_hand_qty"/>
                <field name="sold_last_6_months"/>
                <field name="avg_sold_last_6_months"/>
                <field name="equ_month"/>
                <field name="naap"/>
                <field name="value"/>
            </tree>
        </field>
    </record>

    <record id="action_stock_views" model="ir.actions.act_window">
        <field name="name">Stock Views</field>
        <field name="res_model">stock.views</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create and manage Sales Reports Views.
            </p>
        </field>
    </record>

    <menuitem name="Inventory Report view"
              id="menu_inventory_action_stock_views"
              action="action_stock_views"
              parent="parent_menu_inventory_wizard_view_action"
              sequence="100"/>


</odoo>