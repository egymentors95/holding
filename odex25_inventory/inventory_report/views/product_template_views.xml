<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="dos_product_template_only_form_view" model="ir.ui.view">
        <field name="name">dos.product.template.only.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="dos"/>
                <field name="private_category_id"/>
            </xpath>

        </field>
    </record>

       <record id="replinish_product_template_form_view_procurement_button" model="ir.ui.view">
        <field name="name">replinish.product.template.form.view.procurement.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='351']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>