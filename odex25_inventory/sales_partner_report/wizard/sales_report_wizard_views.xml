<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sales_report_wizard_view_form" model="ir.ui.view">
            <field name="name">sales.report.wizard.view</field>
            <field name="model">sales.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                                <field name="groub_by_partner"/>
                                <field name="partner_ids" widget="many2many_tags" attrs="{'invisible': [('groub_by_partner', '!=', 'partners')]}"/>
                                <field name="partner_category_ids" widget="many2many_tags" attrs="{'invisible': [('groub_by_partner', '!=', 'category')]}"/>

                            </group>
                            <group>
                                <field name="product_ids" widget="many2many_tags"/>
                                <field name="product_category_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="View(Report)" name="action_print_report_html" type="object"
                                class="btn-primary"/>
                        <button string="Export Xlsx" name="action_print_report_xlsx" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="sales_report_wizard_view_action" model="ir.actions.act_window">
            <field name="name">ٍSales Partner Report</field>
            <field name="res_model">sales.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
            </field>
        </record>

        <menuitem id="sales_partner_wizard_view_menu" name="ٍSales Partner Report"
                  parent="sale.menu_sale_report" action="sales_partner_report.sales_report_wizard_view_action"
                  sequence="200"/>


    </data>
</odoo>