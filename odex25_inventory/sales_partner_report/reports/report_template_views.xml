<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header">
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="8">
                            <div>
                                <span style="font-weight: bold;">Report:</span>
                                <span>Sales Report</span>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date from:</span>
                                <span t-esc="report_data and report_data.get('date_from')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Date to:</span>
                                <span t-esc="report_data and report_data.get('date_to')"/>
                            </div>
                            <div>
                                <span style="font-weight: bold;">Currency:</span>
                                <span>SR</span>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;">
                            <img src='/sales_partner_report/static/img/logo.png' width="120px"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

   <template id="sales_partner_report_html">
    <t t-call="web.html_container">
        <t t-call="sales_partner_report.custom_header"/>

        <t t-set="partners"
           t-value="list(set([rec['Partner'] or 'No Partner' for rec in (report_data or {}).get('product_ids', [])]))"/>

        <t t-foreach="partners" t-as="partner">
            <div class="page">
                <h3 style="margin:10px 0; background-color: #27F53C;">Partner:
                    <t t-esc="partner"/>
                </h3>

                <table class="table table-sm table-bordered"
                       style="width:100%; border: 1px solid black; text-align: center;">
                    <thead style="background-color: #f0f0f0; font-weight: bold;">
                        <tr>
                            <th rowspan="2">Product Category</th>
                            <th rowspan="2">Code</th>
                            <th rowspan="2">Product</th>
                            <th colspan="3" style="background-color:#27C2F5;">Last Year</th>
                            <th colspan="3" style="background-color:#27F5C1;">Current</th>
                        </tr>
                        <tr>
                            <th style="background-color:#27C2F5;">QTY</th>
                            <th style="background-color:#27C2F5;">Value</th>
                            <th style="background-color:#27C2F5;">NASP</th>
                            <th style="background-color:#27F5C1;">QTY</th>
                            <th style="background-color:#27F5C1;">Value</th>
                            <th style="background-color:#27F5C1;">NASP</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- grand totals per partner -->
                        <t t-set="grand_totals" t-value="{'last_year_price': 0, 'total_price': 0}"/>

                        <!-- build grouped data -->
                        <t t-set="grouped_data" t-value="{}"/>
                        <t t-foreach="(report_data or {}).get('product_ids', [])" t-as="line">
                            <t t-if="(line['Partner'] or 'No Partner') == partner">
                                <t t-set="cat" t-value="line['Product Category'] or 'No Category'"/>
                                <t t-set="priv" t-value="line.get('private_category') or ''"/>

                                <!-- init structures -->
                                <t t-if="not grouped_data.get(cat)">
                                    <t t-set="grouped_data" t-value="dict(grouped_data, **{cat: {}})"/>
                                </t>
                                <t t-if="not grouped_data[cat].get(priv)">
                                    <t t-set="grouped_data" t-value="dict(grouped_data, **{cat: dict(grouped_data[cat], **{priv: []})})"/>
                                </t>

                                <!-- append line -->
                                <t t-set="grouped_data" t-value="dict(grouped_data, **{
                                    cat: dict(grouped_data[cat], **{priv: grouped_data[cat][priv] + [line]})
                                })"/>
                            </t>
                        </t>

                        <!-- iterate grouped -->
                        <t t-foreach="grouped_data.items()" t-as="cat_data">
                            <t t-set="category" t-value="cat_data[0]"/>
                            <t t-set="priv_cats" t-value="cat_data[1]"/>

                            <!-- Category Header -->
                            <tr style="background-color:#F0EBEB; font-weight:bold;">
                                <td colspan="9" style="text-align:left;">
                                    <t t-esc="category"/>
                                </td>
                            </tr>

                            <!-- reset category totals -->
                            <t t-set="cat_totals" t-value="{'last_year_price':0, 'total_price':0}"/>

                            <t t-foreach="priv_cats.items()" t-as="priv_data">
                                <t t-set="priv_name" t-value="priv_data[0]"/>
                                <t t-set="lines" t-value="priv_data[1]"/>

                                <!-- reset private totals -->
                                <t t-set="priv_totals" t-value="{'last_year_qty_dos':0,'last_year_price':0,'total_qty_dos':0,'total_price':0}"/>

                                <!-- private category lines -->
                                <t t-foreach="lines" t-as="line">
                                    <t t-set="dos_value" t-value="line.get('Dos') or 0"/>

                                    <tr>
                                        <td></td>
                                        <td><t t-esc="line['Default Code']"/></td>
                                        <td><t t-esc="line['Product']"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Last Year Total Quantity'])"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Last Year Total Price'])"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Last Year Nsap'])"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Total Quantity'])"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Total Price'])"/></td>
                                        <td><t t-esc="'{:,.2f}'.format(line['Nsap'])"/></td>
                                    </tr>

                                    <!-- update private totals -->
                                    <t t-set="priv_totals" t-value="{
                                        'last_year_qty_dos': priv_totals['last_year_qty_dos'] + ((line['Last Year Total Quantity'] or 0) * dos_value),
                                        'last_year_price': priv_totals['last_year_price'] + (line['Last Year Total Price'] or 0),
                                        'total_qty_dos': priv_totals['total_qty_dos'] + ((line['Total Quantity'] or 0) * dos_value),
                                        'total_price': priv_totals['total_price'] + (line['Total Price'] or 0)
                                    }"/>
                                </t>

                                <!-- private subtotal -->
                                <tr style="background-color:#D1F5E0; font-weight:bold;">
                                    <td colspan="3" style="text-align:center;">Subtotal (<t t-esc="priv_name"/>)</td>
                                    <td><t t-esc="'{:,.2f}'.format(priv_totals['last_year_qty_dos']/1000000)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(priv_totals['last_year_price'])"/></td>
                                    <td></td>
                                    <td><t t-esc="'{:,.2f}'.format(priv_totals['total_qty_dos']/1000000)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(priv_totals['total_price'])"/></td>
                                    <td></td>
                                </tr>

                                <!-- update category totals -->
                                <t t-set="cat_totals" t-value="{
                                    'last_year_price': cat_totals['last_year_price'] + priv_totals['last_year_price'],
                                    'total_price': cat_totals['total_price'] + priv_totals['total_price']
                                }"/>
                            </t>

                            <!-- Category Total -->
                            <tr style="background-color:#D6EAF8; font-weight:bold; color:white;">
                                <td colspan="4" style="text-align:center;">Total (<t t-esc="category"/>)</td>
                                <td><t t-esc="'{:,.2f}'.format(cat_totals['last_year_price'])"/></td>
                                <td></td>
                                <td></td>
                                <td><t t-esc="'{:,.2f}'.format(cat_totals['total_price'])"/></td>
                                <td></td>
                            </tr>

                            <!-- update grand totals -->
                            <t t-set="grand_totals" t-value="{
                                'last_year_price': grand_totals['last_year_price'] + cat_totals['last_year_price'],
                                'total_price': grand_totals['total_price'] + cat_totals['total_price']
                            }"/>
                        </t>

                        <!-- Grand Total -->
                        <tr style="background-color:#D6EAF8; font-weight:bold; border-top:2px solid black;">
                            <td colspan="4" style="text-align:center;">Grand Total</td>
                            <td><t t-esc="'{:,.2f}'.format(grand_totals['last_year_price'])"/></td>
                            <td></td>
                            <td></td>
                            <td><t t-esc="'{:,.2f}'.format(grand_totals['total_price'])"/></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </t>
</template>


</odoo>
