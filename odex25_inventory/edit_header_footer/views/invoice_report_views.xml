<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_invoice_customize">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">

                    <div class="page">
                        <table class="table table-sm table-bordered"
                               style="width:100%; border: 2px solid black; font-size: 13px; table-layout:fixed; border-collapse:collapse; padding:0; margin:0;"
                               dir="ltr">
                            <tbody>
                                <tr>
                                    <td height="50px;" style="text-align: center; vertical-align: middle;">
                                        <div style="
                                                border: 1px solid black;
                                                border-radius: 10px;
                                                font-size: 16px;
                                                text-align: center;
                                                width: 70%;
                                                margin: 0 auto;
                                                height: 40px;
                                            ">
                                            <span t-field="o.invoice_user_id"/>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                                            <table class="table table-sm table-bordered"
                           style="width:100%; border: 2px solid black; font-size: 13px; table-layout:fixed; border-collapse:collapse; padding:0; margin:0;"
                           dir="ltr">
                        <tbody>
                            <tr>
                                <td width="20%"
                                    style="text-align: left; border-right: 1px solid white; border-bottom: 2px solid black;">
                                    <span>رقم الفاتورة</span>
                                    <br/>
                                    <span>Invoice No.</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-bottom: 2px solid black; border-right: 2px solid black;">
                                    <span t-field="o.name"/>
                                </td>
                                <td width="60%" rowspan="3" colspan="3" dir="rtl"
                                    style="border-right: 2px solid black;">
                                    <div style="text-align: right;">
                                        <span>العميل:</span>
                                        <span t-field="o.partner_id.name"/>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;">
                                        <span>الرقم الضريبي:</span>
                                        <span t-field="o.partner_id.vat"/>
                                        <span style="margin-right: 100px;">P.O.NO.</span>
                                        <span></span>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;">
                                        <span>العنوان:</span>
                                        <span t-field="o.partner_id.street"/>
                                        <span t-field="o.partner_id.street2"/>
                                        <span t-field="o.partner_id.country_id"/>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;">
                                        <span>ملاحظات:</span>
                                    </div>

                                </td>
                            </tr>
                            <tr>
                                <td width="20%"
                                    style="text-align: left; border-right: 1px solid white; border-bottom: 2px solid black; ">
                                    <span>التاريخ</span>
                                    <br/>
                                    <span>Date</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-bottom: 2px solid black; border-right: 2px solid black;">
                                    <span t-field="o.invoice_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="20%" style="text-align: left; border-right: 1px solid white;">
                                    <span>البائع</span>
                                    <br/>
                                    <span>Salesman</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-right: 2px solid black;">
                                    <span t-field="o.invoice_user_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                        <br/>

                        <table class="table table-borderless"
                               style="border-radius: 8px; font-size: 13px;">
                            <thead>
                                <tr>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Code</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Description</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Lot</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Foc</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Qty</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Price</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Vat</span>
                                    </th>
                                    <th style="background-color:#195C19; color: white; border: 1px solid white; text-align:center;">
                                        <span>Total</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.product_id.default_code"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.product_id.name"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.lot_id.name"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.foc"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.quantity"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-esc="line.price_unit"/>
                                        </td>
                                        <td style="border: 1px solid white; text-align: center;">
                                            <span t-field="line.tax_ids"/>
                                        </td>
                                        <td style="background-color: #DBDBDB; text-align: center;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>

                                    </tr>
                                </t>

                            </tbody>

                        </table>

                        <div class="row">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-border">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <span class="text-left">Untaxed Amount</span>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="o.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                            <tr style="">
                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">
                                                    <td class="text-left">
                                                        <span class="text-nowrap" t-esc="amount_by_group[0]"/>
                                                    </td>
                                                    <td class="text-right o_price_total">
                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-left">
                                                        <span t-esc="amount_by_group[0]"/>
                                                        <span class="text-nowrap">on
                                                            <t t-esc="amount_by_group[4]"/>
                                                        </span>
                                                    </td>
                                                    <td class="text-right o_price_total">
                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>

                                        <tr>
                                            <td class="text-left" style="background-color:#195C19; color: white;">
                                                <span>Total</span>
                                            </td>
                                            <td class="text-right" style="background-color:#195C19; color: white;">
                                                <span t-field="o.amount_total"/>
                                            </td>
                                        </tr>


                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <br/>
                        <div style="text-align:center; vertical-align: middle;">

                            <img t-if="o.l10n_sa_qr_code_str"
                                 style="display:block;margin:10% auto 0 auto;"
                                 t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', o.l10n_sa_qr_code_str, 150, 150)"/>

                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>