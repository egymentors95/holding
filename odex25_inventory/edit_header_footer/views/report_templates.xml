<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="header">
        <t t-set="company" t-value="docs.company_id"/>
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row" style="font-size: 14px; font-family: Arial, sans-serif;">
                <div class="col-5 header-left" style="text-align: left;">
                    <div style="font-weight: bold; ">
                        <span>Zaghwan Co for Trading and Industry</span>
                    </div>
                    <div>
                        <span>Headoffice -Dobbat -Malaz Area -Riyadh</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">Tel:</span>
                        <span>0114770000 Fax 0114771308</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">P.O.Box:</span>
                        <span>43192 -Riyadh 12623</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">C.R:</span>
                        <span>1010132043 C.C. 3436</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">VAT No.:</span>
                        <span>300207667710003</span>
                    </div>
                </div>

                <!-- Logo Center -->
                <div class="col-2 header-logo" style="text-align: center; vertical-align: middle;">
                    <div>
                        <br/>
                        <br/>
                        <img src='/edit_header_footer/static/img/logo1.png' width="170px"/>

                    </div>
                </div>

                <!-- Header Right -->
                <div class="col-5 header-right" style="text-align: right;" dir="rtl">
                    <div style="font-weight: bold; ">
                        <span>شركة زغوان للتجارة والصناعة</span>
                    </div>
                    <div>
                        <span>المكتب الرئيسي - حي الضباط الملز - الرياض</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">هاتف:</span>
                        <span>0114770000</span>
                        <span style="font-weight: bold; ">فاكس:</span>
                        <span>0114771308</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">ص ب:</span>
                        <span>43192 الرياض 12623</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">سجل تجاري:</span>
                        <span>1010132043 غرفة تجارية3436</span>
                    </div>
                    <div>
                        <span style="font-weight: bold; ">رقم ضريبي:</span>
                        <span>300207667710003</span>
                    </div>
                </div>
            </div>
        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>

        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div style="text-align:center; font-size: 12px;">
                <div>
                    <span>الفروع الرياض ش سلام 0114115690 جدة 0126710262 الدمام 0138172502 بريدة 0163828758 خميس مشيط
                        0172202422
                    </span>
                </div>
                <div>
                    <span>Branches Riyadh Salam St 0114115690 - jeddah 0126710262 Dammam 0138172502 Braidah 0163828758
                        Khamis Masheet 0172202422
                    </span>
                </div>
                <div>
                    <span>www.alsahliholding.com</span>
                </div>
                <div t-if="report_type == 'pdf'" class="text-muted" style="margin-top: 3px;">
                    Page
                    <span class="page"/>
                    of
                    <span class="topage"/>
                </div>
            </div>
        </div>
    </template>


    <template id="external_layout_background_inherit" inherit_id="l10n_gcc_invoice.arabic_english_invoice">
        <xpath expr="//t[1]" position="replace">
            <t t-call="edit_header_footer.header">

                <t t-set="o_sec" t-value="o.with_context(lang='ar_001')"/>
                <t t-set="o" t-value="o.with_context(lang='en_US')"/>

                <div class="page" style="font-family: Arial, sans-serif;">
                    <div class="row"
                         style="width:100%; border: 1px solid black; font-size: 14px; padding:4px;; margin:0; height: 40px; vertical-align: middle; font-weight: bold;"
                         dir="ltr">
                        <div class="col-6" style="vertical-align: middle;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                Tax Invoice
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                Draft Invoice
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                Cancelled Invoice
                            </span>
                            <span t-if="o.move_type == 'out_refund'">
                                Credit Note
                            </span>
                            <span t-if="o.move_type == 'in_refund'">
                                Vendor Credit Note
                            </span>
                            <span t-if="o.move_type == 'in_invoice'">
                                Vendor Bill
                            </span>

                        </div>
                        <div class="col-6" style="text-align: right; vertical-align: middle;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                فاتورة ضريبية
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                مسودة فاتورة
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                فاتورة ملغاة
                            </span>
                            <span t-if="o.move_type == 'out_refund'">
                                إشعار خصم
                            </span>
                            <span t-if="o.move_type == 'in_refund'">
                                إشعار خصم المورد
                            </span>
                            <span t-if="o.move_type == 'in_invoice'">
                                فاتورة المورد
                            </span>

                        </div>
                    </div>
                    <table class="table table-sm table-bordered"
                           style="width:100%; border: 2px solid black; font-size: 13px; table-layout:fixed; border-collapse:collapse; padding:0; margin:0;"
                           dir="ltr">
                        <tbody>
                            <tr>
                                <td width="20%"
                                    style="text-align: left; border-right: 1px solid white; border-bottom: 2px solid black;">
                                    <span>رقم الفاتورة</span>
                                    <br/>
                                    <span>Invoice No.</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-bottom: 2px solid black; border-right: 2px solid black;">
                                    <span t-field="o.name"/>
                                </td>
                                <td width="60%" rowspan="3" colspan="3" dir="rtl"
                                    style="border-right: 2px solid black;">
                                    <div style="text-align: right;">
                                        <span>العميل:</span>
                                        <span t-field="o.partner_id.name"/>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;" class="row">
                                        <div class="col-6">
                                            <span>الرقم الضريبي:</span>
                                            <span t-field="o.partner_id.vat"/>
                                        </div>
                                        <div class="col-1"/>
                                        <div class="col-3" style="text-align: left;">
                                            <span t-field="o.description_note"/>
                                        </div>
                                        <div class="col-2">
                                            <span>:P.O.NO</span>
                                        </div>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;">
                                        <span>العنوان:</span>
                                        <span t-field="o.partner_id.street"/>
                                        <span t-field="o.partner_id.street2"/>
                                        <span t-if="o.partner_id.building_no">رقم المبنى</span>
                                        <span t-field="o.partner_id.building_no"/>
                                        <span t-if="o.partner_id.district">حي</span>
                                        <span t-field="o.partner_id.district"/>
                                        <span t-if="o.partner_id.city">مدينة</span>
                                        <span t-field="o.partner_id.city"/>
                                        <span t-if="o.partner_id.zip">رمز بريدي</span>
                                        <span t-field="o.partner_id.zip"/>
                                        <span t-field="o.partner_id.country_id"/>
                                    </div>
                                    <br/>
                                    <div style="text-align: right;">
                                        <span>ملاحظات:</span>
                                        <span t-field="o.description_a"/>
                                    </div>

                                </td>
                            </tr>
                            <tr>
                                <td width="20%"
                                    style="text-align: left; border-right: 1px solid white; border-bottom: 2px solid black; ">
                                    <span>التاريخ</span>
                                    <br/>
                                    <span>Date</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-bottom: 2px solid black; border-right: 2px solid black;">
                                    <span t-field="o.invoice_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="20%" style="text-align: left; border-right: 1px solid white;">
                                    <span>البائع</span>
                                    <br/>
                                    <span>Salesman</span>
                                </td>
                                <td width="20%"
                                    style="text-align: right; vertical-align: middle; border-right: 2px solid black;">
                                    <span t-field="o.invoice_user_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                    <table class="table table-sm table-bordered" name="invoice_line_table"
                           style="border: 1px solid black; font-size: 12px; text-align: center; vertical-align: middle;">

                        <thead>
                            <tr>
                                <t t-set="colspan" t-value="6"/>
                                <th name="th_item_code">
                                    <span>
                                        رقم الصنف
                                    </span>
                                    <br/>
                                    <span>
                                        Item Code
                                    </span>
                                </th>
                                <th name="th_description">
                                    <span>
                                        بيان البضاعة
                                    </span>
                                    <br/>
                                    <span>
                                        Description
                                    </span>
                                </th>
                                <th name="th_unit">
                                    <span>
                                        الوحدة
                                    </span>
                                    <br/>
                                    <span>
                                        Unit
                                    </span>
                                </th>

                                <th name="th_quantity">
                                    <span>
                                        عدد
                                    </span>
                                    <br/>
                                    <span>
                                        Qty
                                    </span>
                                </th>
                                <th name="th_quantity">
                                    <span>
                                        رقم التشغيلة
                                    </span>
                                    <br/>

                                    <span>
                                        Batch
                                    </span>
                                </th>
                                <th name="th_priceunit"
                                >
                                    <span>
                                        سعر الوحدة
                                    </span>
                                    <br/>
                                    <span>
                                        Unit price

                                    </span>
                                </th>
                                <th name="th_subtotal">
                                    <span>
                                        إجمالي بدون ضريبة
                                    </span>
                                    <br/>
                                    <span>
                                        Amount
                                    </span>
                                </th>
                                <th name="th_tax_amount"
                                >
                                    <span>
                                        الضريبة
                                    </span>
                                    <br/>
                                    <span>
                                        VAT
                                    </span>
                                </th>
                                <th name="th_total">
                                    <span>
                                        إجمالي بالضريبة
                                    </span>
                                    <br/>
                                    <span>
                                        Total Amount
                                    </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines"
                               t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>


                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                   groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                   groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                        <td>
                                            <span t-esc="line.product_id.default_code or ''"/>
                                        </td>
                                        <td name="account_invoice_line_name">
                                            <span t-esc="line.product_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_uom_id"/>
                                        </td>
                                        <td>
                                            <span t-esc="int(line.quantity)"/>
                                        </td>
                                        <td class="o_price_total">
                                            <span t-esc="line.lot_id.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="'%.2f' % line.price_unit"/>
                                        </td>

                                        <td class="o_price_total">
                                            <span t-esc="'%.2f' % line.price_subtotal"/>
                                        </td>


                                        <td>
                                            <span t-esc="'%.2f' % line.l10n_gcc_invoice_tax_amount"/>

                                        </td>

                                        <td class="text-right o_price_total">
                                            <span t-esc="'%.2f' % line.price_total"/>

                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>

                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-right">
                                        <td colspan="99">
                                            <strong class="mr16" style="display: inline-block">Subtotal/الإجمالي
                                                الفرعي
                                            </strong>
                                            <span
                                                    t-esc="current_subtotal"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix pt-4 pb-3" style="font-size: 14px;">
                        <div id="total" class="row">
                            <div class="col-8">
                                <table class="table table-sm" style="page-break-inside: avoid;">
                                    <tr class="border-black o_subtotal">
                                        <td>
                                            <strong>
                                                الإجمالي بدون ضريبة
                                            </strong>
                                            <span>Total Without Vat</span>
                                        </td>
                                        <td style="text-align: right;">
                                            <span t-field="o.amount_untaxed"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                        <tr style="">
                                            <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">
                                                <td>
                                                    <span class="text-nowrap" t-esc="amount_by_group[0]"/>
                                                </td>
                                                <td class="text-right o_price_total">
                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <td>
                                                    <span t-esc="amount_by_group[0]"/>
                                                    <span class="text-nowrap">on
                                                        <t t-esc="amount_by_group[4]"/>
                                                    </span>
                                                </td>
                                                <td class="text-right o_price_total">
                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                    <!--                                    <tr class="border-black o_total">-->
                                    <tr>
                                        <td>
                                            <strong>
                                                الاجمالي بضريبة القيمة المضافة
                                            </strong>
                                            <span>Total With Vat</span>
                                        </td>
                                        <td style="text-align: right;">
                                            <span class="text-nowrap" t-field="o.amount_total"/>
                                        </td>
                                    </tr>

                                    <t t-if="print_with_payments">
                                        <t t-if="o.payment_state != 'invoicing_legacy'">
                                            <t t-set="payments_vals"
                                               t-value="o.sudo()._get_reconciled_info_JSON_values()"/>
                                            <t t-foreach="payments_vals" t-as="payment_vals">
                                                <tr class="border-black o_total">
                                                    <td>
                                                        <i class="row">
                                                            <div class="col-7 oe_form_field oe_payment_label">
                                                                Paid on/دفعت في:
                                                            </div>
                                                            <div class="col-5 pl-0 oe_form_field oe_payment_label">
                                                                <t t-esc="payment_vals['date']"/>
                                                            </div>
                                                        </i>
                                                    </td>
                                                    <td>
                                                        <span t-esc="payment_vals['amount']"
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="len(payments_vals) > 0">
                                                <tr class="border-black">
                                                    <td>
                                                        <strong>
                                                            Amount Due
                                                            /
                                                            المبلغ المستحق
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <span t-field="o.amount_residual"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </table>
                            </div>
                            <div class="col-4" style="text-align: right; vertical-align: middle;">
                                <img t-if="o.l10n_sa_qr_code_str"
                                     style="display:block;margin:10% auto 0 auto;"
                                     t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', o.l10n_sa_qr_code_str, 150, 150)"/>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-6">
                            <div style="font-size: 14px; font-weight: bold; text-align: right">
                                <br/>
                                <span>اسم المستلم</span>
                                <br/>
                                <br/>
                                <span>التوقيع</span>

                            </div>
                            <div>
                                <t t-if="o.authorized_signature">
                                    <img t-att-src="'data:image/png;base64,%s' % o.authorized_signature"
                                         style="height:150px; width:80px;"/>
                                </t>
                                <t t-elif="o.partner_id and o.partner_id.signature">
                                    <img t-att-src="'data:image/png;base64,%s' % o.partner_id.signature"
                                         style="height:150px; width:80px;"/>
                                </t>
                            </div>
                        </div>
                    </div>

                </div>
            </t>

        </xpath>
    </template>


</odoo>
