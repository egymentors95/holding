<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_inherit_header_footer" model="ir.ui.view">
        <field name="name">res.company.form.inherit.header.footer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Report Header &amp; Footer">
                    <group string="Header">
                        <field name="header_left" widget="html"/>
                        <field name="header_right" widget="html"/>
                    </group>
                    <group string="Footer">
                        <field name="footer_html" widget="html"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
