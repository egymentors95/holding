<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="invoice_details_wizard_view_form" model="ir.ui.view">
            <field name="name">invoice.details.wizard</field>
            <field name="model">invoice.details.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="partner_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Print (PDF)" name="action_print_report_pdf" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="invoice_details_wizard_view_action" model="ir.actions.act_window">
            <field name="name">Invoice Details Report</field>
            <field name="res_model">invoice.details.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
            </field>
        </record>

        <menuitem id="invoice_details_wizard_view_menu" name="Invoice Details Report"
                  parent="account.menu_finance_reports"
                  sequence="600"/>
         <menuitem id="invoice_details_wizard_view_menu_one" name="Invoice Details Report"
                  parent="invoice_details_wizard_view_menu"
                   action="invoice_details_wizard_view_action"
                  sequence="100"/>


    </data>
</odoo>