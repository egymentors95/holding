<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_header">
        <t t-set="company" t-value="docs[0].env.user.company_id"/>
        <div class="header">
            <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                <tbody>
                    <tr>
                        <td colspan="4" style="text-align: right;">
                            <img t-att-src="'data:image/png;base64,%s' % (company.logo.decode('utf-8') if company.logo else '')"
                                 width="120px"/>
                        </td>
                        <td colspan="4">
                            <div style="border: 1px solid black; padding: 5px; text-align: center;">
                                <span style="font-weight: bold; color: blue; font-size: 16px;">كشف حساب عميل</span>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <strong style="color: blue;">من:</strong>
                                    <t t-esc="report_data.get('date_from','')"/>

                                </div>
                                <div class="col-6">
                                    <strong style="color: blue;">إلى:</strong>
                                    <t t-esc="report_data.get('date_to','')"/>

                                </div>
                            </div>
                        </td>
                        <td colspan="4" style="text-align: right;" dir="rtl">
                            <span>التاريخ:</span>
                            <t t-esc="report_data.get('date_to','')"/>

                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>


    <template id="account_statement_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="docs[0]"/>
                <t t-set="report_data" t-value="report_data_list[0]"/>
                <t t-set="company" t-value="o.env.user.company_id"/>

                <div class="header">
                    <table class="table table-borderless" style="border: none; width: 100%;" dir="ltr">
                        <tbody>
                            <tr>
                                <td colspan="4" style="text-align: right;" dir="rtl">
                                    <span>التاريخ:</span>
                                    <t t-esc="report_data.get('date_to','')"/>

                                </td>

                                <td colspan="4">
                                    <div style="border: 1px solid black; padding: 5px; text-align: center;">
                                        <span style="font-weight: bold; color: blue; font-size: 16px;">كشف حساب عميل
                                        </span>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <strong style="color: blue;">إلى:</strong>
                                            <t t-esc="report_data.get('date_to','')"/>
                                        </div>
                                        <div class="col-6">
                                            <strong style="color: blue;">من:</strong>
                                            <t t-esc="report_data.get('date_from','')"/>
                                        </div>
                                    </div>
                                </td>
                                <td colspan="4" style="text-align: right;">
                                    <img t-att-src="'data:image/png;base64,%s' % (company.logo.decode('utf-8') if company.logo else '')"
                                         width="120px"/>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>


                <div class="page" style="direction: rtl; font-size: 14px;" dir="rtl">
                    <div style="color: black; font-size: 18px;  text-align: right;">
                        <strong>العميل:</strong>
                        <t t-esc="report_data.get('partner_name','')"/>
                    </div>


                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr style="color: black; text-align: center; padding: 5px; background-color: #B2BEB5;">
                                <th>التاريخ</th>
                                <th>القيد</th>

                                <th>المستند</th>
                                <th>التفاصيل</th>

                                <th>مدين</th>
                                <th>دائن</th>
                                <th>الرصيد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_data.get('lines',[])" t-as="l">
                                <tr style="text-align: center; padding: 5px;">
                                    <td>
                                        <t t-esc="l.get('date','')"/>
                                    </td>
                                    <td>
                                        <t t-esc="l.get('document','')"/>
                                    </td>
                                    <td style="color: blue;">
                                        <t t-esc="l.get('sequence','')"/>
                                    </td>
                                    <td>
                                        <t t-esc="l.get('description','')"/>
                                    </td>

                                    <td class="text-right">
                                        <t t-esc="l.get('debit',0.0)"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="l.get('credit',0.0)"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="l.get('balance',0.0)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table style="width:100%; margin-top:0;">
                        <tr>
                            <td>
                                <strong>الرصيد</strong>
                            </td>
                            <td>
                                <strong>إجمالي المدين:</strong>
                                <t t-esc="report_data.get('total_debit',0.0)"/>
                            </td>
                            <td>
                                <strong>إجمالي الدائن:</strong>
                                <t t-esc="report_data.get('total_credit',0.0)"/>
                            </td>
                            <td>
                                <strong>الرصيد النهائي:</strong>
                                <t t-esc="report_data.get('ending_balance',0.0)"/>
                            </td>
                        </tr>
                    </table>

                    <table class="table table-bordered table-sm">
                        <tr style="color: black; text-align: center; padding: 5px; ">
                            <th>
                                <span>0 - 30</span>
                                <span>يوم</span>
                            </th>
                            <th>
                                <span>31 - 60</span>
                                <span>يوم</span>
                            </th>
                            <th>
                                <span>61 - 90</span>
                                <span>يوم</span>
                            </th>
                            <th>
                                <span>91 - 120</span>
                                <span>يوم</span>
                            </th>
                            <th>
                                <span>121 - 150</span>
                                <span>يوم</span>
                            </th>
                            <th>
                                <span>أكثر من 150</span>
                                <span>يوم</span>
                            </th>
                            <th>الصافي</th>

                        </tr>
                        <tr style="text-align: center;">
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('0_30',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('31_60',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('61_90',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('91_120',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('121_150',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="report_data.get('aging',{}).get('150_plus',0.0)"/>
                            </td>
                            <td>
                                <t t-esc="sum(report_data.get('aging',{}).values())"/>
                            </td>

                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>
</odoo>
