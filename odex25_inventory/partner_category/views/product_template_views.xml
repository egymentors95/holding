<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="product_category_form_view_inherit" model="ir.ui.view">
        <field name="name">product.category.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="product_category"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="الوحدات البديلة">
                    <field name="utm_line_ids">
                        <tree editable="bottom">
                            <field name="uom_id"/>
                        </tree>
                    </field>

                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Form View to Modify it -->
    <record id="inherit_product_template_form_view_sale_order_button" model="ir.ui.view">
        <field name="name">inheri.product.template.form.view.sale.order.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_stock.product_template_view_form_inherit_stock"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_view_sales']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>

        </field>
    </record>

    <!-- Inherit Form View to Modify it -->
    <record id="inherit_product_form_view_sale_order_button" model="ir.ui.view">
        <field name="name">inherit.product.form.view.sale.order.button</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="sale.product_form_view_sale_order_button"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_view_sales']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>

        </field>
    </record>


</odoo>


